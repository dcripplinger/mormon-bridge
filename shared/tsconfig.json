{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["vitest/globals"],
    "paths": {
      "@game/*": ["../web/src/game/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
